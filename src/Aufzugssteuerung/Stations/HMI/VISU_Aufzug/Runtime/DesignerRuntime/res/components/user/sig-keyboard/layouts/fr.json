{
    "lang": "fr",
    "name": "French",
    "autor": "SIGMATEK GmbH & Co KG",
    "version": "1.0",
    "layouts": {
        "alpha": {
            "layers": {
                "normal": [
                    "\u00B2 & \u00E9 \" ' ( - \u00E8 _ \u00E7 \u00E0 ) = {bksp}",
                    "{tab} a z e r t y u i o p ^ $",
                    "q s d f g h j k l m \u00F9 * {accept}",
                    "{shift} < w x c v b n , ; : ! {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ],
                "shift": [
                    "{off} 1 2 3 4 5 6 7 8 9 0 \u00B0 + {bksp}",
                    "{tab} A Z E R T Y U I O P \u00A8 \u00A3",
                    "Q S D F G H J K L M % \u00B5 {accept}",
                    "{shift} > W X C V B N ? . / \u00A7 {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ],
                "alt": [
                    "{off} {off} ~ # { [ | ` \\ ^ @ ] } {bksp}",
                    "{tab} {off} {off} \u20AC {off} {off} {off} {off} {off} {off} {off} {off} \u00A4",
                    "{off} {off} {off} {off} {off} {off} {off} {off} {off} {off} {off} {off} {accept}",
                    "{shift} {off} {off} {off} {off} {off} {off} {off} {off} {off} {off} {off} {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ]
            }
        },
        "numeric": {
            "config": {
                "regexValidation": "numeric"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {increase}",
                    "1 2 3 {decrease}",
                    ". 0 {minus} {accept}"
                ]
            }
        },
        "ipv4": {
            "config": {
                "regexValidation": "ipv4"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ". 0 {off} {accept}"
                ]
            }
        },
        "hex": {
            "config": {
                "regexValidation": "hex"
            },
            "layers": {
                "normal": [
                    "C D E F {bksp}",
                    "8 9 A B {undo}",
                    "4 5 6 7 {clear}",
                    "0 1 2 3 {accept}"
                ]
            }
        },
        "time": {
            "config": {
                "regexValidation": "time"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ": 0 {off} {accept}"
                ]
            }
        },
        "date": {
            "config": {
                "regexValidation": "date"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ". 0 - {accept}"
                ]
            }
        }
    }
}
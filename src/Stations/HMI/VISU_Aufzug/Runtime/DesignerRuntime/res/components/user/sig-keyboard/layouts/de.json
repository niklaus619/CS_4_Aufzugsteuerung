    "layouts": {
        "alpha": {
            "layers": {
                "normal": [
                    "^ 1 2 3 4 5 6 7 8 9 0 \u00df \u0301 {bksp}",
                    "{tab} q w e r t z u i o p \u00fc +",
                    "a s d f g h j k l \u00f6 \u00e4 # {accept}",
                    "{shift} < y x c v b n m , . - {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ],
                "shift": [
                    "° ! \" \u00a7 $ % & / ( ) = ? \u0300 {bksp}",
                    "{tab} Q W E R T Z U I O P \u00dc *",
                    "A S D F G H J K L \u00d6 \u00c4 ' {accept}",
                    "{shift} > Y X C V B N M ; : _ {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ],
                "alt": [
                    "° 1 \u00b2 \u00b3 4 5 6 { [ ] } \\ \u0301 {bksp}",
                    "{tab} @ w \u20ac r t z u i o p \u00fc ~",
                    "a s d f g h j k l \u00f6 \u00e4 # {accept}",
                    "{shift} \u007c y x c v b n \u00b5 , . - {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ]
            }
        },
        "numeric": {
            "config": {

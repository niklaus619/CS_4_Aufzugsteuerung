FUNCTION GLOBAL clsAufzugantrieb::Fahrt
VAR_INPUT
    xDir   : BOOL; // TRUE = hoch/positiv, FALSE = runter/negativ
    xStart : BOOL;
END_VAR
VAR_OUTPUT
    xBusy  : BOOL;
END_VAR

IF xStart THEN

    IF xDir THEN
        IF (iStep <> 10) AND (iStep <> 20) THEN
            iStep := 10;
        END_IF;
    ELSE
        IF (iStep <> 30) AND (iStep <> 40) THEN
            iStep := 30;
        END_IF;
    END_IF;

    xBusy := TRUE;

ELSE

    IF iStep <> 0 THEN
        iStep := 99;
    END_IF;

    xBusy := FALSE;

END_IF;


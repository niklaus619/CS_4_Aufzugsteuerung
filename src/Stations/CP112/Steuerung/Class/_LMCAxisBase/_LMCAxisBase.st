	      6 bNoAutomaticSS2,  //! <Type Comment="Flag which defines if an automatic SS2 should be done or not. The feature is active by default. When the feature is deactivated the application must handle SS2 by itself.&#13;&#10;0 ... automatic SS2 active&#13;&#10;1 ... automatic SS2 inactive" Name="t_s_SafetyData.Flags.bNoAutomaticSS2"/>
	      7 bSBTatPowerOnDeactivated,  //! <Type Comment="Flag which stores when the user actively deactived automatic SBT feature in init before the the SBT values are read from the axis. When the user actively deactived feature it is not activated later." Name="t_s_SafetyData.Flags.bSBTatPowerOnDeactivated"/>
	      9 bFuncReferenced,  //! <Type Comment="Temporary flag to store either,&#13;&#10;the state of the functional reference, when a safety reference is done or,&#13;&#10;the result of the functional reference, when a safety reference is performed directly after functional reference finished successful." Name="t_s_SafetyData.Flags.bFuncReferenced"/>
	      10 bReadVerifyState,  //! <Type Comment="Local marking flag to read the verify state in background, when it should be updated automatically.&#13;&#10;The verify state is automatically read when a SetVerify or a ClearVerify is performed." Name="t_s_SafetyData.Flags.bReadVerifyState"/>
	      11 bReadReferenceState,  //! <Type Comment="Local marking flag to read the reference state in background, when it should be updated automatically.&#13;&#10;The reference state is automatically read when a ClearReference is performed." Name="t_s_SafetyData.Flags.bReadReferenceState"/>
	      12 bSafeAxisLogin,  //! <Type Comment="Local marking flag that login to safe drive axis class worked. Call back is active and data handling works." Name="t_s_SafetyData.Flags.bSafeAxisLogin"/>
	      13 bSafeErrorQuitActive,  //! <Type Comment="Flag marking that a safey error quit must be performed. The flag is set as long as the safety error quit is done or it is marked, that a safe error quit should be done.&#13;&#10;Only active when bit bDoSafeErrorQuit is set." Name="t_s_SafetyData.Flags.bSafeErrorQuitActive"/>
	      14 bReReadReferenceState,  //! <Type Comment="Local marking flag to mark that a reread of the reference state is triggered." Name="t_s_SafetyData.Flags.bReReadReferenceState"/>
	      17 bSBTMinTorqueRead,  //! <Type Comment="Local flag marking that the minimal torque value of SBT is already read after boot up of the axis." Name="t_s_SafetyData.Flags.bSBTMinTorqueRead"/>
	      18 bSBTTestTimeRead,  //! <Type Comment="Local flag marking that the test time value of SBT is already read after boot up of the axis." Name="t_s_SafetyData.Flags.bSBTTestTimeRead"/>
	      19 bSBTTestIntervalRead,  //! <Type Comment="Local flag marking that the test interval value of SBT is already read after boot up of the axis." Name="t_s_SafetyData.Flags.bSBTTestIntervalRead"/>
	      20 bSBTMinTorqueError,  //! <Type Comment="Local flag marking that reading the minimal torque value of SBT failed." Name="t_s_SafetyData.Flags.bSBTMinTorqueError"/>
	      21 bSBTTestTimeError,  //! <Type Comment="Local flag marking that reading the test time value of SBT failed." Name="t_s_SafetyData.Flags.bSBTTestTimeError"/>
	      22 bSBTTestIntervalError,  //! <Type Comment="Local flag marking that reading the test interval value of SBT failed." Name="t_s_SafetyData.Flags.bSBTTestIntervalError"/>
	      23 bSafeErrorCodeError,  //! <Type Comment="Reading the safety error code from SC1 failed. Stored value is invalid." Name="t_s_SafetyData.Flags.bSafeErrorCodeError"/>
	      24 bAxisHWError,  //! <Type Comment="Value of AxisError.HWError from one cycle before the actual cycle. Used to trigger reading the safety error code from the axis, when a hw error occured." Name="t_s_SafetyData.Flags.bAxisHWError"/>
	    ];
	    SBTData : t_s_SBTData;  //! <Type Comment="Substructure storing relevant data of SBT handling and setting values." Name="t_s_SafetyData.SBTData"/>

{
    "lang": "sv",
    "name": "Swedish",
    "author": "SIGMATEK GmbH & Co KG",
    "version": "2.0",
    "layouts": {
        "alpha": {
            "layers": {
                "normal": [
                    "\u00A7 1 2 3 4 5 6 7 8 9 0 + \u00B4 {bksp}",
                    "{tab} q w e r t y u i o p \u00E5 \u00A8",
                    "a s d f g h j k l \u00F6 \u00E4 ' {accept}",
                    "{shift} < z x c v b n m , . - {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ],
                "shift": [
                    "\u00BD ! \" # \u00A4 % & / ( ) = ? ` {bksp}",
                    "{tab} Q W E R T Y U I O P \u00C5 ^",
                    "A S D F G H J K L \u00D6 \u00C4 * {accept}",
                    "{shift} > Z X C V B N M ; : _ {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ],
                "alt": [
                    "{off} {off} @ \u00A3 $ \u20AC {off} { [ ] } \\ {off} {bksp}",
                    "{tab} {off} {off} \u20AC {off} {off} {off} {off} {off} {off} {off} {off} ~",
                    "{off} {off} {off} {off} {off} {off} {off} {off} {off} {off} {off} {off} {accept}",
                    "{shift} | {off} {off} {off} {off} {off} {off} \u00B5 {off} {off} {off} {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ]
            }
        },
        "numeric": {
            "config": {
                "regexValidation": "numeric"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {increase}",
                    "1 2 3 {decrease}",
                    ". 0 {minus} {accept}"
                ]
            }
        },
        "ipv4": {
            "config": {
                "regexValidation": "ipv4"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ". 0 {off} {accept}"
                ]
            }
        },
        "hex": {
            "config": {
                "regexValidation": "hex"
            },
            "layers": {
                "normal": [
                    "C D E F {bksp}",
                    "8 9 A B {undo}",
                    "4 5 6 7 {clear}",
                    "0 1 2 3 {accept}"
                ]
            }
        },
        "time": {
            "config": {
                "regexValidation": "time"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ": 0 {off} {accept}"
                ]
            }
        },
        "date": {
            "config": {
                "regexValidation": "date"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ". 0 - {accept}"
                ]
            }
        }
    }
}
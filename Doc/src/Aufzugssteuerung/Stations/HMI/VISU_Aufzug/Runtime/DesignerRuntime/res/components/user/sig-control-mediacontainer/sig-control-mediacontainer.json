        ------------------------------------------------------------------------------------------------------*/
        {
            "valueSourceTypes": [
                "accessNumber"
            ],
            "propertyType": "none",
            "name": "accessNumber",
            "sortIndex": 200500,
            "dataType": "number",
            "shortName": {
                "en": "Access number",
                "de": "Access number"
            },
            "description": {
                "en": "The access number needed to use this control.",
                "de": "Die benötigte Zugriffsnummer, um die Komponente verwenden zu können."
            },
            "group": {
                "en": "State",
                "de": "State"

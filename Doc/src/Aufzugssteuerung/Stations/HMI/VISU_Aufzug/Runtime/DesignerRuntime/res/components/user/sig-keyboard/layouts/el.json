{
    "lang": "el",
    "name": "Greek",
    "author": "SIGMATEK GmbH & Co KG",
    "version": "2.0",
    "layouts": {
        "alpha": {
            "layers": {
                "normal": [
                    "` 1 2 3 4 5 6 7 8 9 0 - = {bksp}",
                    "{tab} ; \u03C2 \u03B5 \u03C1 \u03C4 \u03C5 \u03B8 \u03B9 \u03BF \u03C0 [ ]",
                    "\u03B1 \u03C3 \u03B4 \u03C6 \u03B3 \u03B7 \u03BE \u03BA \u03BB \u0384 ' \\ {accept}",
                    "{shift} < \u03B6 \u03C7 \u03C8 \u03C9 \u03B2 \u03BD \u03BC , . / {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ],
                "shift": [
                    "~ ! @ # $ % ^ & * ( ) _ + {bksp}",
                    "{tab} : \u0385 \u0395 \u03A1 \u03A4 \u03A5 \u0398 \u0399 \u039F \u03A0 { }",
                    "\u0391 \u03A3 \u0394 \u03A6 \u0393 \u0397 \u039E \u039A \u039B \u00A8 \" | {accept}",
                    "{shift} > \u0396 \u03A7 \u03A8 \u03A9 \u0392 \u039D \u039C < > ? {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ],
                "alt": [
                    "{off} {off} \u00B2 \u00B3 \u00A3 \u00A7 \u00B6 {off} \u00A4 \u00A6 \u00B0 \u00B1 \u00BD {bksp}",
                    "{tab} {off} {off} \u20AC \u00AE {off} \u00A5 {off} {off} {off} {off} \u00AB \u00BB",
                    "{off} {off} {off} {off} {off} {off} {off} {off} {off} \u0385 {off} \u00AC {accept}",
                    "{shift} {off} {off} {off} \u00A9 {off} {off} {off} {off} {off} {off} {off} {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ]
            }
        },
        "numeric": {
            "config": {
                "regexValidation": "numeric"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {increase}",
                    "1 2 3 {decrease}",
                    ". 0 {minus} {accept}"
                ]
            }
        },
        "ipv4": {
            "config": {
                "regexValidation": "ipv4"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ". 0 {off} {accept}"
                ]
            }
        },
        "hex": {
            "config": {
                "regexValidation": "hex"
            },
            "layers": {
                "normal": [
                    "C D E F {bksp}",
                    "8 9 A B {undo}",
                    "4 5 6 7 {clear}",
                    "0 1 2 3 {accept}"
                ]
            }
        },
        "time": {
            "config": {
                "regexValidation": "time"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ": 0 {off} {accept}"
                ]
            }
        },
        "date": {
            "config": {
                "regexValidation": "date"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ". 0 - {accept}"
                ]
            }
        }
    }
}
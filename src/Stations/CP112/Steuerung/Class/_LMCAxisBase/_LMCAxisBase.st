	    ReferenceCmd : DINT;  //! <Type Comment="Stores the reference command value of the last read of the reference state when triggered by GetSafetyData(LMCAXIS_PAR_GET_SAFETY_REFERENCESTATE). For a list of possible values confer to DriveSafetyIF.h file." Name="t_s_SafetyData.ReferenceCmd"/>
	    ReferenceState : DINT;  //! <Type Comment="Stores the reference state value of the last read of the reference state when triggered by GetSafetyData(LMCAXIS_PAR_GET_SAFETY_REFERENCESTATE). For a list of possible values confer to DriveSafetyIF.h file." Name="t_s_SafetyData.ReferenceState"/>
	    SafetyRunState : t_e_DRIVESAFETYIF_SafetyRunState;  //! <Type Comment="Read SafetyRunState from the hw - the safety run state is read once at bootup of class." Name="t_s_SafetyData.SafetyRunState"/>
	    SafeErrorCodeSC1 : DINT;  //! <Type Comment="Read safety error code from safety controller 1 - to determine if a safety error is active." Name="t_s_SafetyData.SafeErrorCodeSC1"/>
	    SafeQuitTimeMark : UDINT;  //! <Type Comment="Time mark of request to quit the safety error" Name="t_s_SafetyData.SafeQuitTimeMark"/>
	    CmdState : iprStates;  //! <Type Comment="Stores the command state of the last read of the verify or reference state when triggered by GetSafetyData(LMCAXIS_PAR_GET_SAFETY_REFERENCESTATE).&#13;&#10;Allowed values:&#13;&#10;READY ... the command was successfully processed&#13;&#10;BUSY ... the command is still processing&#13;&#10;ERROR ... processing the command failed -  async communication failed" Name="t_s_SafetyData.CmdState"/>
	    ExecState : iprStates;  //! <Type Comment="Stores the execution state of the last read of the verify or reference state when triggered by GetSafetyData(LMCAXIS_PAR_GET_SAFETY_REFERENCESTATE).&#13;&#10;Allowed values:&#13;&#10;READY ... the execution value is valid and the request was processed successfully.&#13;&#10;BUSY ... the command is still processing and the execution value is not updated&#13;&#10;ERROR ... processing the command failed -  async communication failed" Name="t_s_SafetyData.ExecState"/>
	    DriveAxisState : DINT;  //! <Type Comment="Value of DriveAxis is updated in Background task cyclically. The last read value of AxisState server of connected DriveAxis is available here." Name="t_s_SafetyData.DriveAxisState"/>
	    DriveExecState : iprStates;  //! <Type Comment="AxisState of DriveAxis is updated in Background task cyclically. The execution state shows if the stored value is valid.&#13;&#10;READY ... AxisState is valid and read in Background-Task&#13;&#10;BUSY ... AxisState is read at the moment&#13;&#10;ERROR ... can not read AxisState - value of AxisState is not valid" Name="t_s_SafetyData.DriveExecState"/>
	    ActiveSafeFnct : t_e_DRIVESAFETYIF_ActiveSafeFnct;  //! <Type Comment="Bit field copy of HWK bit field to show the active safety function. The type of this variable is a copy of MDD2000 HWK server type for general usage in DriveSafetyIF.h." Name="t_s_SafetyData.ActiveSafeFnct"/>
	    ActiveSafeFnctValid : DINT;  //! <Type Comment="Marks if the values of ActiveSafeFunct are valid.&#13;&#10;READY ... valid data&#13;&#10;ERROR ... reading of data failed&#13;&#10;ERROR_BUSY ... reading successful, but values are not valid at the moment. Wait to receive valid data." Name="t_s_SafetyData.ActiveSafeFnctValid"/>
	    ActiveSafeFnctRetCode : DINT;  //! <Type Comment="RetCode of request to read active safe function from hardware class.&#13;&#10;READY ... successful request&#13;&#10;ERROR ... requested failed&#13;&#10;BUSY ... request not finished" Name="t_s_SafetyData.ActiveSafeFnctRetCode"/>
	    pMasterThis : ^void;  //! <Type Comment="Pointer to connected master of safe axis. Gets set by SetParameter(LMCAXIS_PAR_SET_MASTERPOINTER, ...) by _LMCProfile object." Name="t_s_SafetyData.pMasterThis"/>
	    NIParaCmdStruct : CmdStruct;  //! <Type Comment="CmdStruct to handle NewInst commands directly from _LMCAxis concerning safety features.&#13;&#10;At the moment it is only used to trigger a StopMove in case of SS2 at the connected profile object." Name="t_s_SafetyData.NIParaCmdStruct"/>
	    NIParaCmdResult : results;  //! <Type Comment="Results struct to handle NewInst commands directly from _LMCAxis concerning safety features.&#13;&#10;At the moment it is only used to trigger a StopMove in case of SS2 at the connected profile object." Name="t_s_SafetyData.NIParaCmdResult"/>
	    Flags : BDINT  //! <Type Comment="Bit structure to store the bits linked to SafetyData handling or axis functions linked to a safe axis." Name="t_s_SafetyData.Flags"/>
	    [
	      1 bSBTatPowerOn,  //! <Type Comment="SBT is automatically performed, when a PowerOn() on the axis is done." Name="t_s_SafetyData.Flags.bSBTatPowerOn"/>
	      2 bSBTatPowerOnIgnore,  //! <Type Comment="SBT will not be triggered the next time a PowerOn() is done regardless of the general setting. It is also ignored if the last SBT failed or was successful." Name="t_s_SafetyData.Flags.bSBTatPowerOnIgnore"/>

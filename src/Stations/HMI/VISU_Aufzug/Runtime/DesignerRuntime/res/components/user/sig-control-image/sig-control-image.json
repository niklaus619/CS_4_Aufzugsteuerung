            "shortName": {
                "en": "External source",
                "de": "External source"
            },
            "description": {
                "en": "An external source path of an image which isn't configured in the lvd project. If something is configured at this property, this source is used instead the one configured at the Image property.",
                "de": "Ein Pfad eines externen Bildes, welches nicht im LVD Projekt verwaltet wird. Ist hier etwas konfiguriert, so wird diese Quelle anstatt der am Image Property konfigurierten verwendet."
            },
            "group": {
                "en": "Data",
                "de": "Data"
            },
            "userLevel": [
                20,
                20,
                20
            ],
            "tab": {
                "en": "Data",
                "de": "Data"
            },
            "tabIndex": 10

            "shortName": {
                "en": "Media",
                "de": "Media"
            },
            "editor": "urlpicker",
            "description": {
                "en": "The content source of the media container.",
                "de": "Die Inhaltsquelle des Mediencontainers."
            },
            "group": {
                "en": "Data",
                "de": "Data"

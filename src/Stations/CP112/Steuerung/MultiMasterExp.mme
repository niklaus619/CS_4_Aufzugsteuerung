		<RemoteServer Name="HwControl1.DiasMaster" Name_DESC="Name" GUID_Svr="{346AEDBC-831D-4D5C-B71F-A1BF17D120A4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{429BB3BC-672B-4C78-909C-4C59A546D6E1}" GUID_Obj_DESC="GUID of the object" Comment="connect to client &apos;to_HWControl&quot; of class DiasMasterC if used (if Server is 1 class is connected)&#13;&#10;" Comment_DESC="Comment of server"/>
		<RemoteServer Name="HwControl1.SafetyState" Name_DESC="Name" GUID_Svr="{7E088AB6-AB0A-450E-964A-E46FE15A0D4B}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{429BB3BC-672B-4C78-909C-4C59A546D6E1}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Shows state of safety functionality initialisation&#13;&#10;&#13;&#10; 1..OK&#13;&#10; 0..not active or initializing&#13;&#10;-1..failed to allocate memory&#13;&#10;-2..invalid domain number set in this system&#13;&#10;-3..newer OS version required for domain number support&#13;&#10;-4..method to determine domain number not provided by lsl_st_hardwaretree.h&#13;&#10;-5..only 1 instance of safety manager allowed&#13;&#10;-6..a slave system can only have 1 master. check hw class configuration&#13;&#10;-7..invalid module type tried to log in&#13;&#10;-8..couldn&apos;t find InterfaceCRC which is requested by other domain. Check SafetyDesigner projects, most likely the interface variables doesn&apos;t match.&#13;&#10;-9..failed to add a new copy data object to varan manager&#13;&#10;-10..a non-optional module or domain is not available&#13;&#10;-11..timeout in initialisation (see debugger trace or logfile for further details)&#13;&#10;-13..the class safetymanager could not login into the class HwControl." Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP1111.ClassState" Name_DESC="Name" GUID_Svr="{070CD62D-F011-403B-A668-118E2A1842A7}" GUID_Svr_DESC="GUID of the server" Class="SdiasBase" Class_DESC="Class" DataType="t_e_VaranErrors" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Server shows the current Status of the Hardware Class." Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP1111.DeviceID" Name_DESC="Name" GUID_Svr="{1F67076F-D511-400A-8CEF-0F0E0579EC0B}" GUID_Svr_DESC="GUID of the server" DataType="UDINT" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Server shows the DeviceID of the Hardware Module." Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP1111.FPGAVersion" Name_DESC="Name" GUID_Svr="{D5EF701A-412A-4C34-AA2E-FFC7D82C2F86}" GUID_Svr_DESC="GUID of the server" DataType="HDINT" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Server shows the actual FPGA Version of the Module in the format x.y&#13;&#10;&#13;&#10;e.g. 16#10 means v1.0" Comment_DESC="Comment of server"/>

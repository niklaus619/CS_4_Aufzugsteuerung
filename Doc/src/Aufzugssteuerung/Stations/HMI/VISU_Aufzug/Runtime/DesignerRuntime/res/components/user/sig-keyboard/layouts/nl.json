{
    "lang": "nl",
    "name": "Dutch",
    "author": "SIGMATEK GmbH & Co KG",
    "version": "2.0",
    "layouts": {
        "alpha": {
            "layers": {
                "normal": [
                    "@ 1 2 3 4 5 6 7 8 9 0 / \u00B0 {bksp}",
                    "{tab} q w e r t y u i o p \u00A8 * {accept}",
                    "a s d f g h j k l + \u00B4 <",
                    "{shift} ] z x c v b n m , . - {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ],
                "shift": [
                    "\u00A7 ! \" # $ % & _ ( ) ' ? ~ {bksp}",
                    "{tab} Q W E R T Y U I O P ^ | {accept}",
                    "A S D F G H J K L \u00B1 ` >",
                    "{shift} [ Z X C V B N M ; : = {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ],
                "alt": [
                    "\u00AC \u00B9 \u00B2 \u00B3 \u00BC \u00BD \u00BE \u00A3 { } {off} \\ \u00B8 {bksp}",
                    "{tab} {off} {off} \u20AC \u00B6 {off} {off} {off} {off} {off} {off} {off} {off} {accept}",
                    "{off} \u00DF {off} {off} {off} {off} {off} {off} {off} {off} {off} {off}",
                    "{shift} \u00A6 \u00AB \u00BB \u00A2 {off} {off} {off} \u00B5 {off} \u00B7 {off} {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ]
            }
        },
        "numeric": {
            "config": {
                "regexValidation": "numeric"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {increase}",
                    "1 2 3 {decrease}",
                    ". 0 {minus} {accept}"
                ]
            }
        },
        "ipv4": {
            "config": {
                "regexValidation": "ipv4"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ". 0 {off} {accept}"
                ]
            }
        },
        "hex": {
            "config": {
                "regexValidation": "hex"
            },
            "layers": {
                "normal": [
                    "C D E F {bksp}",
                    "8 9 A B {undo}",
                    "4 5 6 7 {clear}",
                    "0 1 2 3 {accept}"
                ]
            }
        },
        "time": {
            "config": {
                "regexValidation": "time"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ": 0 {off} {accept}"
                ]
            }
        },
        "date": {
            "config": {
                "regexValidation": "date"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ". 0 - {accept}"
                ]
            }
        }
    }
}
{
    "name": "sig-control-image",
    "shortName": {
        "en": "Image",
        "de": "Image"
    },
    "controlType": {
        "en": "Media",
        "de": "Media"
    },
    "version": "02.01.000",
    "authors": [
        "SIGMATEK GmbH & Co KG"
    ],
    "description": {
        "en": "Implements an image control as a polymer custom element.",
        "de": "Implementiert eine Bild-Komponente als benutzerdefiniertes Polymer-Element."
    },
    "main": [
        "sig-control-image.js"
    ],
    "moduleType": [
        "es6"
    ],
    "license": "http://www.sigmatek-automation.com/LICENSE.txt",
    "homepage": "http://www.sigmatek-automation.com/sig-control-image.html",
    "private": true,
    "baseComponent": "sig-element",
    "dependencies": {
        "sig-element": "components/sig-element#^1.2.0",
        "polymer": "Polymer/polymer#^3.3.0"
    },
    "defaultDimensions": {
        "width": "100px",
        "height": "100px"
    },
    "resources": [
        {
            "designerAction": "addToPublish",
            "path": "./sig-control-image-css.js"
        }
    ],
    "toolbox": true,
    "slotted": false,
    "styleClassEditor": true,
    "usableInShadowDom": true,
    "moduleImport": {
        "importType": "dynamic",
        "area": [
            "index",
            "designer",
            "designerToolbox"
        ],
        "section": "head",
        "position": "bottom"
    },
    "placementTemplates": [
        {
            "default": true,
            "name": "place-image-default",
            "shortName": {
                "en": "Image",
                "de": "Image"
            },
            "typeId": "mediaItem",
            "valueSourceTypes": "mediaImage",
            "--theme-sig-control-image-background-image": []
        }
    ],
    "properties": [

        "numeric": {
            "config": {
                "regexValidation": "numeric"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {increase}",
                    "1 2 3 {decrease}",
                    ". 0 {minus} {accept}"
                ]
            }
        },
        "ipv4": {
            "config": {
                "regexValidation": "ipv4"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ". 0 {off} {accept}"
                ]
            }
        },
        "hex": {
            "config": {
                "regexValidation": "hex"
            },
            "layers": {
                "normal": [
                    "C D E F {bksp}",
                    "8 9 A B {undo}",
                    "4 5 6 7 {clear}",
                    "0 1 2 3 {accept}"
                ]
            }
        },
        "time": {
            "config": {
                "regexValidation": "time"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ": 0 {off} {accept}"
                ]
            }
        },
        "date": {
            "config": {
                "regexValidation": "date"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ". 0 - {accept}"
                ]
            }
        }

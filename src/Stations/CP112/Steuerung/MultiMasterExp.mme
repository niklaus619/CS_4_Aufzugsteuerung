		<RemoteServer Name="HwControl1.Control" Name_DESC="Name" GUID_Svr="{6E0C095B-B92D-47BE-BA84-39E07206C58D}" GUID_Svr_DESC="GUID of the server" Class="HwControlBase" Class_DESC="Class" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{429BB3BC-672B-4C78-909C-4C59A546D6E1}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" HasNewInst="true" HasNewInst_DESC="Multimaster server has NewInst commands" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="connect VaranManager classes" Comment_DESC="Comment of server"/>

		<RemoteServer Name="SCP1111.SerialNo" Name_DESC="Name" GUID_Svr="{68FBC413-E3CB-4059-BC09-1D975B4D4819}" GUID_Svr_DESC="GUID of the server" Class="String" Class_DESC="Class" DataType="UDINT" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" Type="Object Channel" Type_DESC="Type" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Serial number of the Hardware Module." Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP1111.RetryCounter" Name_DESC="Name" GUID_Svr="{833C80D1-4726-4DCB-B1AB-C268D7D72245}" GUID_Svr_DESC="GUID of the server" DataType="UDINT" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Number of Retries on SDIAS-Bus." Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP1111.SafetyState" Name_DESC="Name" GUID_Svr="{1C61AEC1-1DB4-494A-BB65-88BAD86607BA}" GUID_Svr_DESC="GUID of the server" DataType="SafetyConfigStateType" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Shows state of safety module&#13;&#10;&#13;&#10;_ModuleNotFound:&#13;&#10; - Module has not been found at the given position&#13;&#10;&#13;&#10;_WaitForSynchronicity:&#13;&#10; - Waiting to get synchrony with interacting modules&#13;&#10;&#13;&#10;_SafetyClassOK:&#13;&#10; - Module has been found and no errors reported&#13;&#10;&#13;&#10;_MemAllocFailed: &#13;&#10; - Failed to allocate or reallocate some memory for the module&#13;&#10;&#13;&#10;_ReadFWVerFailed:&#13;&#10; - Failed to read firmware version of module&#13;&#10;&#13;&#10;_ReinitConfig:&#13;&#10; - Only for CPU: Config of CPU has changed and update is in progress&#13;&#10;&#13;&#10;_ModFromCfgNotFound (Only for CPU):&#13;&#10; - Module in configuration, which is not physically available and HW-Class is placed&#13;&#10; - Module in configuration, which is not physically available and no HW-Class is placed&#13;&#10; - Module in configuration, which is not a CDIAS module (according to it&apos;s HW-Path)&#13;&#10;&#13;&#10;_UnsafeVarNotFound (Only for CPU):&#13;&#10; - Couldn&apos;t find an unsafe variable in the project. Compare spelling in Designer and in project.&#13;&#10;&#13;&#10;_UnknownCfgError (Only for CPU):&#13;&#10; - Error in reading config or creating routing tables occured.&#13;&#10;&#13;&#10;_AsyncComError: &#13;&#10; - Too many consecutive asynchronous commands failed! Please contact Sigmatek Support! &#13;&#10; &#13;&#10;_DOsIncreasedRestartApp: &#13;&#10; - Number or size of module accesses increased with new safety project! &#13;&#10; - =&gt; Can&apos;t continue, because the new data is not covered by the actual accesses! Restart Application! &#13;&#10; &#13;&#10;_LostPowerSupply: &#13;&#10; - The power supply of the safe CPU has been lost. &#13;&#10; &#13;&#10;_WrongSafetyHW: &#13;&#10; - The Safety objects in the project do not match the physical modules. &#13;&#10; - For every physical module a safety object must be placed in the project!" Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP1111.RunState" Name_DESC="Name" GUID_Svr="{505E7FD0-1D16-49C8-9046-FDC7C879ECAA}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="0: not running&#13;&#10;1: running in operational or temporary operational mode" Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP1111.ServiceMode" Name_DESC="Name" GUID_Svr="{64B9AD40-F811-4EA4-A753-CD7DFD5C2230}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="0: operational mode&#13;&#10;1: service mode or temporary operational mode&#13;&#10;2: check configuration phase" Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP1111.ErrorState" Name_DESC="Name" GUID_Svr="{97F68A06-7C65-48EA-8747-7C685BBBBAF1}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="0: no error&#13;&#10;1: error&#13;&#10;2: communication timeout on input data from other safety modules" Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP1111.QuitComError" Name_DESC="Name" GUID_Svr="{8F2D6E32-DB61-4B9A-A52C-6566EFE9F015}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" Comment="Write to this server to quit communication errors (indicated if Server ErrorState = 2)&#13;&#10;This server can also quit general errors (Server ErrorState = 1) if the safety.dlm is used.&#13;&#10;&#13;&#10;To detect the used quit method, read the server directly after writing. In both cases the error quitting is done asynchronously (= not immediately).&#13;&#10;&#13;&#10;Server shows actual quit-state&#13;&#10;  2..busy with quitting general errors (safety dll version 6 or higher required)&#13;&#10;  1..busy with quitting communication error&#13;&#10;  0..ready&#13;&#10; -1..error at creating a new safety state&#13;&#10; -2..failed to disable user prompt for quit error&#13;&#10; -3..failed to select module via safety number&#13;&#10; -4..error at establishing connection to module (safety designer must not be online at the same time!)&#13;&#10; -5..failed to send the quit error command to the module&#13;&#10; -6..failed to delete the created safety state" Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP1111.FirmwareVersion" Name_DESC="Name" GUID_Svr="{99D3F343-CFCA-4C79-A783-5B921AE2119D}" GUID_Svr_DESC="GUID of the server" DataType="HDINT" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Firmware version and module ID&#13;&#10;&#13;&#10;Format:&#13;&#10;16#XXXXYYYY&#13;&#10;&#13;&#10;XXXX = Module-ID&#13;&#10;  0x419 = 1049 =&gt; SCP111&#13;&#10;  0x44F = 1103 =&gt; SCP211&#13;&#10;&#13;&#10;YYYY = Firmware Version" Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP1111.SafetyNumber" Name_DESC="Name" GUID_Svr="{6C2DC144-9119-4CA0-8B66-11868AB52785}" GUID_Svr_DESC="GUID of the server" DataType="HDINT" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Shows the unique safety number of this module" Comment_DESC="Comment of server"/>

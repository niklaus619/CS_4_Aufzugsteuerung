{
    "name": "sig-control-mediacontainer",
    "shortName": {
        "en": "MediaContainer",
        "de": "MediaContainer"
    },
    "controlType": {
        "en": "Media",
        "de": "Media"
    },
    "version": "02.01.000",
    "authors": [
        "SIGMATEK GmbH & Co KG"
    ],
    "description": {
        "en": "Implements a media container component as a polymer custom element.",
        "de": "Implementiert eine Mediencontainer-Komponente als benutzerdefiniertes Polymer-Element."
    },
    "main": [
        "sig-control-mediacontainer.js"
    ],
    "moduleType": [
        "es6"
    ],
    "license": "http://www.sigmatek-automation.com/LICENSE.txt",
    "homepage": "http://www.sigmatek-automation.com/sig-control-mediacontainer.html",
    "private": true,
    "baseComponent": "sig-element",
    "dependencies": {
        "sig-element": "components/sigmatek/sig-element#^1.2.0",
        "sig-control-scrollbar": "components/user/sig-control-scrollbar#^1.2.0",
        "polymer": "Polymer/polymer#^3.3.0"
    },
    "resources": [
        {
            "designerAction": "addToPublish",
            "path": "./sig-control-mediacontainer-css.js"
        },
        {
            "designerAction": "componentDependency",
            "path": "sig-control-scrollbar"
        }
    ],
    "defaultDimensions": {
        "width": "100px",
        "height": "100px"
    },
    "toolbox": true,
    "slotted": false,
    "styleClassEditor": true,
    "usableInShadowDom": true,
    "moduleImport": {
        "importType": "dynamic",
        "area": [
            "index",
            "designer",
            "designerToolbox"
        ],
        "section": "head",
        "position": "bottom"
    },
    "placementTemplates": [
        {
            "default": true,
            "name": "place-media-default",
            "shortName": {
                "en": "Media",
                "de": "Media"
            },
            "typeId": "mediaItem",
            "src": []
        }
    ],
    "properties": [

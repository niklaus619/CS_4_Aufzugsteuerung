		<RemoteServer Name="SCP1111.FCN_Command" Name_DESC="Name" GUID_Svr="{325FD72B-AEAC-439E-BE73-FC17DB6B8E0C}" GUID_Svr_DESC="GUID of the server" DataType="UDINT" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" Comment="The server shows the currently pending command in the SCP firmware in relation with the FlexConNode functionality&#13;&#10;&#13;&#10;Write 1 to this server to establish a connection with the FlexConHost (FCN_StateMachine has to be 1 = IDLE State)&#13;&#10;" Comment_DESC="Comment of server"/>

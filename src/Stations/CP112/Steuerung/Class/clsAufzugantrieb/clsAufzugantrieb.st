        IF cFahrbefehl.sMode = clsMotorControl::MOTOR_MODE::POWER_ON THEN
            iStep := 40;
        END_IF;

    40: // Fahren negativ
        cFahrbefehl.moveREL(distance:=-10000000, velocity:=800000, acceleration:=1215752192);

    99: // Stop
        cFahrbefehl.stopNORMAL();
        iStep := 0;

ELSE
    iStep := 99;

END_CASE;

state := READY;


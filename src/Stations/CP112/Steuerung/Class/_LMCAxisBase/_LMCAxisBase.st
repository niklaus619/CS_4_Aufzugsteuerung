	  t_s_SBTData : STRUCT  //! <Type Comment="Structure storing relevant data of SBT handling and setting values." Revision="1.0" Name="t_s_SBTData"> <RevDoku>  <Owner Company="Sigmatek"/>  <Dokumentation Revision="1.0" Date="2023-07-17" Author="StePhi" Company="Sigmatek" Description="Initial version of type"/> </RevDoku></Type>
	    TimeMark : UDINT;  //! <Type Comment="Time mark of the last triggered SBT at PowerOn() - Time out of SBT is done with this time mark." Name="t_s_SBTData.TimeMark"/>
	    TimeMarkSuccess : UDINT;  //! <Type Comment="Time mark of the last successful automatic SBT at PowerOn(). This time mark together with SBTData.TimeOut is used to trigger a SBT automaticallly after some time." Name="t_s_SBTData.TimeMarkSuccess"/>
	    TimeMarkSBTState : UDINT;  //! <Type Comment="Time mark of the last async request to read the SBT state data." Name="t_s_SBTData.TimeMarkSBTState"/>
	    TimeOut : UDINT;  //! <Type Comment="TimeOut value is used as test interval for automatic SBT at PowerOn()." Name="t_s_SBTData.TimeOut"/>
	    ExecState : iprStates;  //! <Type Comment="Copy of the execution state of request to read SBT feature data of drive.&#13;&#10;READY ... SBT state data is valid&#13;&#10;BUSY ... SBT state data is currently read&#13;&#10;ERROR ... SBT state data reading failed" Name="t_s_SBTData.ExecState"/>
	    TimeTillNextTest : UDINT;  //! <Type Comment="Copy of the SBT State information time till next test (time countdown from safety fw of drive). Time is given in seconds." Name="t_s_SBTData.TimeTillNextTest"/>
	    SafeBrakeTestStatus : DINT;  //! <Type Comment="Copy of the safe brake test state of SBT feature of drive.&#13;&#10;&#13;&#10;0x0 .. determine countdown value&#13;&#10;0x1 .. do nothing except countdown check&#13;&#10;0x2 .. perform checks during t_delay&#13;&#10;0x3 .. perform checks during t_static&#13;&#10;0x4 .. perform checks during t_ramp_up&#13;&#10;0x5 .. perform checks during t_test_duration&#13;&#10;0x6 .. SBT completed successfully&#13;&#10;0xE0 .. Functional firmware detected an error in SBT routine&#13;&#10;0xE1 .. SBT not performed in time&#13;&#10;0xE2 .. position value out of limit during t_delay&#13;&#10;0xE3 .. position value out of limit during t_static&#13;&#10;0xE4 .. position value out of limit during t_ramp_up&#13;&#10;0xE5 .. position value out of limit during t_test_duration&#13;&#10;0xE6 .. unexpected brake state (closed instead of open)&#13;&#10;0xE7 .. unexpected brake state (open insted of closed)&#13;&#10;0xE8 .. minimum torque value violated&#13;&#10;0xE9 .. SBT torque applied in wrong direction" Name="t_s_SBTData.SafeBrakeTestStatus"/>
	    BrakeTestStatus : DINT;  //! <Type Comment="Copy of the brake test state of SBT feature of drive.&#13;&#10;&#13;&#10;0 .. Idle – wait for start&#13;&#10;1 .. Prepare variables for measurement and check settings&#13;&#10;2 .. Switch to position service mode and enable axis to open brake&#13;&#10;3 .. Hold position for the set time and measure holding Current&#13;&#10;4 .. Check if axis is enabled&#13;&#10;5 .. Hold Axis for set static time, measure acutal Current and disable axis&#13;&#10;6 .. Switch to current controller and enable axis but leave brake closed&#13;&#10;7 .. Enable Current controller G-MODE -1&#13;&#10;8 .. Check if current controller is enabled&#13;&#10;9 .. Ramp up current&#13;&#10;10 .. Hold current for test time&#13;&#10;11 .. Reduce current to 0 and disable axis&#13;&#10;12 .. Check if axis is disabled and set brake test finished&#13;&#10;13 .. Brake test finished successfully&#13;&#10;98 .. Brake test fault, axis diabled&#13;&#10;99 .. Brake test fault, restore G-MODE" Name="t_s_SBTData.BrakeTestStatus"/>
	    BrakeTestErrorInfo : DINT;  //! <Type Comment="ADD ERROR INFORMATION HERE - COPY FROM HWK" Name="t_s_SBTData.BrakeTestErrorInfo"/>
	    MinTorque : DINT;  //! <Type Comment="Value is given by the safety config.&#13;&#10;Minimum torque-forming current to be applied to the brake while testing" Name="t_s_SBTData.MinTorque"/>
	    TestTime : UDINT;  //! <Type Comment="Value is given by the safety config.&#13;&#10;Minimum test duration time (&quot;minimum torque&quot; must be applied for at least this time)" Name="t_s_SBTData.TestTime"/>
	    TestInterval : UDINT;  //! <Type Comment="Value is given by the safety config..&#13;&#10;SBT must be executed at least every &quot;max test interval cyclic&quot; time." Name="t_s_SBTData.TestInterval"/>
	    RetCode : DINT;  //! <Type Comment="Return code of DoSBT() method. The return value can be used for further error analyzation when SBT at PowerOn() fails.&#13;&#10;-1 ... SBT test was triggered successfully but took longer than time out time&#13;&#10;-2 ... SBT test couldn&apos;t be triggered&#13;&#10;-3 ... SBT state couldn&apos;t be read while SBT test was active.&#13;&#10;-4 ... SBT test failed - safe brake test status is in an error state&#13;&#10;0 ... SBT was finished successfully&#13;&#10;2 ... SBT was triggered successfully and is still active&#13;&#10;3 ... Reading SBT state is not finished but started already&#13;&#10;4 ... The SBT test is still running (the test is neither finished successfully nor failed)" Name="t_s_SBTData.RetCode"/>
	  END_STRUCT;

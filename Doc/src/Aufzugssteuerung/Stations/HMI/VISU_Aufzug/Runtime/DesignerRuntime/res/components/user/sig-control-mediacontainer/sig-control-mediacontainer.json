        // Hide properties from the base
        *****************************************************************************************************/
        {
            "valueSourceTypes": [
                "constNumber"
            ],
            "propertyType": "css",
            "name": "--theme-sig-element-dragged-opacity",
            "userLevel": -1,
            "userLevelStyling": -1
        },
        {
            "valueSourceTypes": [
                "font",
                "fontScheme"
            ],
            "propertyType": "font",
            "name": "elementMainFont",
            "userLevel": -1,

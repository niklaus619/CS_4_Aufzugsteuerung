		<RemoteServer Name="AI0431.AI1" Name_DESC="Name" GUID_Svr="{08A3C829-FE79-4197-9D60-296278BDCF8C}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{A0B4511D-86CB-4BDC-80E4-EF644B408663}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Analog input 1 or temperature input. Status query over read().&#13;&#10;The invalid value in case of cable break or short circuit is 16#80000010.&#13;&#10;Values in 1/10 °C or 1/10 Ohm when type is potentiometer or 1/100°C if AI1Config is 25)" Comment_DESC="Comment of server"/>

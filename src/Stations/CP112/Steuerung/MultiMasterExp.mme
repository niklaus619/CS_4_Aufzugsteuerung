		<RemoteServer Name="SCP1111.ValidationButtonState" Name_DESC="Name" GUID_Svr="{A0B1F955-6FEF-4898-A807-C9A614B77BF4}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Shows the state of the validation button&#13;&#10;0: Validation button not used at the moment&#13;&#10;1: Select a command by pressing the button&#13;&#10;2: Command is executed&#13;&#10;3: Error in module" Comment_DESC="Comment of server"/>
		<RemoteServer Name="SCP1111.FastUnsafeInputs" Name_DESC="Name" GUID_Svr="{F7E36086-DB61-4453-BD44-693DD3AB5FD4}" GUID_Svr_DESC="GUID of the server" DataType="BDINT" DataType_DESC="DataType" GUID_Obj="{D1743FF3-9B37-4F74-8A40-9F1E3DC8682A}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" Comment="write the 32 fast unsafe inputs to this server (bit coded)" Comment_DESC="Comment of server"/>

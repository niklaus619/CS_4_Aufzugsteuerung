        ------------------------------------------------------------------------------------------------------*/
        {
            "valueSourceTypes": [
                "constString",
                "mediaItem",
                "mediaItemScheme"
            ],
            "propertyType": "variable",
            "name": "src",
            "sortIndex": 150000,
            "dataType": "string",
            "default": "",

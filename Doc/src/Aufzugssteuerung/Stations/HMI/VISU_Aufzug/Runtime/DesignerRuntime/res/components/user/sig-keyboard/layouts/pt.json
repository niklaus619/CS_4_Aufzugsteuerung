{
    "lang": "pt",
    "name": "Portuguese",
    "author": "SIGMATEK GmbH & Co KG",
    "version": "2.0",
    "layouts": {
        "alpha": {
            "layers": {
                "normal": [
                    "\\ 1 2 3 4 5 6 7 8 9 0 ' \u00AB {bksp}",
                    "{tab} q w e r t y u i o p + \u00B4",
                    "a s d f g h j k l \u00E7 \u00BA ~ {accept}",
                    "{shift} < z x c v b n m , . - {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ],
                "shift": [
                    "| ! \" # $ % & / ( ) = ? \u00BB {bksp}",
                    "{tab} Q W E R T Y U I O P * `",
                    "A S D F G H J K L \u00C7 \u00AA ^ {accept}",
                    "{shift} > Z X C V B N M ; : _ {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ],
                "alt": [
                    "{off} {off} @ \u00A3 \u00A7 \u20AC {off} { [ ] } {off} {off} {bksp}",
                    "{tab} {off} {off} \u20AC {off} {off} {off} {off} {off} {off} {off} \u00A8 ]",
                    "{off} {off} {off} {off} {off} {off} {off} {off} {off} {off} {off} {off} {accept}",
                    "{shift} {off} {off} {off} {off} {off} {off} {off} {off} {off} {off} {off} {shift}",
                    "{alt} {undo} {curleft} {space} {curright} {clear} {alt}"
                ]
            }
        },
        "numeric": {
            "config": {
                "regexValidation": "numeric"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {increase}",
                    "1 2 3 {decrease}",
                    ". 0 {minus} {accept}"
                ]
            }
        },
        "ipv4": {
            "config": {
                "regexValidation": "ipv4"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ". 0 {off} {accept}"
                ]
            }
        },
        "hex": {
            "config": {
                "regexValidation": "hex"
            },
            "layers": {
                "normal": [
                    "C D E F {bksp}",
                    "8 9 A B {undo}",
                    "4 5 6 7 {clear}",
                    "0 1 2 3 {accept}"
                ]
            }
        },
        "time": {
            "config": {
                "regexValidation": "time"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ": 0 {off} {accept}"
                ]
            }
        },
        "date": {
            "config": {
                "regexValidation": "date"
            },
            "layers": {
                "normal": [
                    "7 8 9 {bksp}",
                    "4 5 6 {undo}",
                    "1 2 3 {clear}",
                    ". 0 - {accept}"
                ]
            }
        }
    }
}
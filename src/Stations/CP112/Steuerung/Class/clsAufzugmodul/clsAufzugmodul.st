//Einfuegen iStep := 0; als Init ist mir noch unklar

//Aktuelle Etage an Aufzugmodul uebergeben
iAktEtage := cEtagestatus.AktEtage();



Case iStep of
  
  
  0: // Initialschritt
  
  
  iStep := 10;
  
  10: //Fahranforderung
  
    IF cAnforderung.Anf0(xIn:=FALSE) OR
       cAnforderung.Anf1(xIn:=FALSE) OR

		<RemoteServer Name="AI0431.Range" Name_DESC="Name" GUID_Svr="{C1B4CA0B-3900-40A9-9A71-DD5374B97B08}" GUID_Svr_DESC="GUID of the server" DataType="BDINT" DataType_DESC="DataType" GUID_Obj="{A0B4511D-86CB-4BDC-80E4-EF644B408663}" GUID_Obj_DESC="GUID of the object" MMType="BDINT" MMType_DESC="Type of the multimaster server" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Range Detection of inputs.&#13;&#10;Bit 0 ... Upper Threshold value of input 1 exceeded.&#13;&#10;Bit 1 ... Upper Threshold value of input 2 exceeded.&#13;&#10;Bit 2 ... Upper Threshold value of input 3 exceeded.&#13;&#10;Bit 3 ... Upper Threshold value of input 4 exceeded.&#13;&#10;&#13;&#10;Bit 4 ... Value of input 1 fall below lower Threshold value.&#13;&#10;Bit 5 ... Value of input 2 fall below lower Threshold value.&#13;&#10;Bit 6 ... Value of input 3 fall below lower Threshold value.&#13;&#10;Bit 7 ... Value of input 4 fall below lower Threshold value.&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;" Comment_DESC="Comment of server"/>

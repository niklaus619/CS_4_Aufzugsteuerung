		<RemoteServer Name="_DriveMng_DC0622_Axis1.AxErrorQuit" Name_DESC="Name" GUID_Svr="{3AA1B785-46E0-41CD-A4ED-90935075A5E3}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{956B6FE5-729A-414B-8BED-E8C61F250A0D}" GUID_Obj_DESC="GUID of the object" Comment="a write command quits the actual error state of the axle" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_DriveMng_DC0622_Axis1.ZPulsLatch" Name_DESC="Name" GUID_Svr="{90CCCE9D-9849-4DA5-9BD8-BF7C7C2A2308}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{956B6FE5-729A-414B-8BED-E8C61F250A0D}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="latched Zero-Impulse of the axle&#13;&#10;(reset on read-out)&#13;&#10;depends on P-PSCALE" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_DriveMng_DC0622_Axis1.AxTorqueControl" Name_DESC="Name" GUID_Svr="{A4AA77E4-9AAF-4B94-8313-9C5FAF9A43D0}" GUID_Svr_DESC="GUID of the server" DataType="UDINT" DataType_DESC="DataType" GUID_Obj="{956B6FE5-729A-414B-8BED-E8C61F250A0D}" GUID_Obj_DESC="GUID of the object" Comment="the torque limit is set here, the actual limit depends on the controlword.&#13;&#10;16bit Controlword - 0 until 1000 from Peak Current&#13;&#10;32bit Controlword - 0 until 4500 from Stall Current" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_DriveMng_DC0622_Axis1.SDDCmdIntfc" Name_DESC="Name" GUID_Svr="{24EEE8C3-EAC3-433F-ACDD-DAB261FE5FAB}" GUID_Svr_DESC="GUID of the server" DataType="_SDDUSERCMD" DataType_DESC="DataType" GUID_Obj="{956B6FE5-729A-414B-8BED-E8C61F250A0D}" GUID_Obj_DESC="GUID of the object" Comment="Server for user commands to the drive:&#13;&#10;_SDDIDLE     .. default command&#13;&#10;_SDDREADALL  .. read all parameters of the drive &#13;&#10;  and save the parameters in the SRAM or in the file.&#13;&#10;  If any parameter classes are connected to the class SDDMngBase,&#13;&#10;  the servers of the parameter classes are refreshed.&#13;&#10;_SDDINIT     .. Initialize the drive with the saved parameters.&#13;&#10;_SDDURINIT   .. Initialize the drive with the parameters of the table.&#13;&#10;  (Lasal2 table, User Table or default table)&#13;&#10;_SDDEXDATA   .. Export the actual drive parameter into an excel formatted file.&#13;&#10;_SDDEXDATAXML   .. Export the actual drive parameter into an xml formatted file.&#13;&#10;_SDDIMDATAXML   .. Imports the drive parameter from an xml formatted file. User commands &quot;_SDDINIT&quot; must be called to transfer the data to the drive.&#13;&#10;_SDDERROR    .. This value is shown, when the user commands &quot;_SDDEXDATAXML&quot; or &quot;_SDDIMDATAXML&quot; failed. See Log-File for details. New user commands can be set in this state.&#13;&#10;&#13;&#10;User commands are only processed if the server &apos;Online&apos; displays 1. &#13;&#10;If the server &apos;Online&apos; is 0, the execution of the command is delayed until the server &apos;Online&apos; becomes 1." Comment_DESC="Comment of server"/>
		<RemoteServer Name="_DriveMng_DC0622_Axis1.I_HC" Name_DESC="Name" GUID_Svr="{8AFC09FE-5A20-47C3-BC1E-F4D9F439F5BE}" GUID_Svr_DESC="GUID of the server" DataType="_I_HC_Type" DataType_DESC="DataType" GUID_Obj="{956B6FE5-729A-414B-8BED-E8C61F250A0D}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Shows Hardware Code of this axis&#13;&#10;&#13;&#10;Bit 31..16 Hardware Code of the Control Board&#13;&#10;Bit 15...8 Software version of the feedback CPLD&#13;&#10;Bit   7...0 Hardware Code of the Power Stage" Comment_DESC="Comment of server"/>
		<RemoteServer Name="_DriveMng_DC0622_Axis1.SerialNo" Name_DESC="Name" GUID_Svr="{1F2B66E1-39C5-490A-9A9A-D23553AD8EAC}" GUID_Svr_DESC="GUID of the server" DataType="DINT" DataType_DESC="DataType" GUID_Obj="{956B6FE5-729A-414B-8BED-E8C61F250A0D}" GUID_Obj_DESC="GUID of the object" WriteProtected="true" WriteProtected_DESC="Write protection of multimaster server" Comment="Serial number of this axis module (or drive if a SDD is used)" Comment_DESC="Comment of server"/>
